* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Preserve imported records byte-for-byte against the archive manifest.
records/backend/** -text -whitespace
records/frontend/** -text -whitespace

# Evaluation summaries hash the original result bytes, including line endings.
records/quality-evaluations/*.json -text whitespace=cr-at-eol
# Preserve nested frozen experiment artifacts when cloning on another OS.
records/quality-evaluations/** -text whitespace=cr-at-eol

# Pre-compression originals are kept byte-for-byte.
legacy/** -text -whitespace
